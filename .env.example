# ==============================================================================
# SRE-Hub Environment Template (.env.example)
# Copy this file to .env or export these variables in your shell (~/.bashrc / ~/.zshrc).
# ==============================================================================

# Local Repositories Directory
REPOS_DIR="${HOME}/repos"

# Local Investigations & Analysis Directory
INVESTIGATIONS_DIR="${HOME}/sre-investigations"

# User Mention Tag (used in Slack thread analysis)
SRE_USER_HANDLE="@username"

# Slack API & Workspace
SLACK_WORKSPACE_URL="https://slack.com"
SLACK_XOXC_TOKEN="xoxc-..."
SLACK_XOXD_TOKEN="xoxd-..."

# Jira Integration (Atlassian Cloud / Data Center)
JIRA_URL="https://jira.example.com"
JIRA_EMAIL="user@example.com"
JIRA_API_TOKEN="your_jira_api_token"

# GitLab Integration
GITLAB_URL="https://gitlab.example.com"
GITLAB_TOKEN="your_gitlab_api_token"

# PagerDuty Integration (Read-only Alerts & Incident Triage)
PAGERDUTY_API_TOKEN="your_pagerduty_api_token"
PAGERDUTY_API_URL="https://api.pagerduty.com"

# Jenkins Integration (Optional)
JENKINS_USER="user"
JENKINS_TOKEN="your_jenkins_api_token"

# Google Gemini API (if using Gemini directly or via 'llm' CLI)
GEMINI_API_KEY="your_gemini_api_key"
